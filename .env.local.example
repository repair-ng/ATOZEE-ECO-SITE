# Database (replaces Supabase entirely)
DATABASE_URL="postgresql://atozee:changeme@localhost:5432/atozee"

# File storage (MinIO, replaces Supabase Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=atozee-uploads
MINIO_PUBLIC_URL=http://localhost:9000/atozee-uploads

# Auth (new) — generate with: openssl rand -hex 32
AUTH_JWT_SECRET=

# WhatsApp / contact
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ADDRESS=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@atozee.example

# Admin area (separate shared-password gate for staff)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Quote threshold
NEXT_PUBLIC_QUOTE_THRESHOLD_NGN=400000

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------------------------------------
# NOTE: Prisma CLI only auto-loads a file literally named `.env` (project
# root or prisma/.env) — it never reads `.env.local`. Next.js reads both.
# Simplest fix: after filling this in and saving as `.env.local`, also copy
# it to `.env` so both tools see the same values:
#   cp .env.local .env        (mac/linux)
#   Copy-Item .env.local .env (PowerShell)
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# Inventory system (/inventory) — staff accounts with roles, separate from
# the shared-password store admin above.
# --------------------------------------------------------------------------
# Signs inventory session cookies. REQUIRED, 32+ chars: openssl rand -hex 32
INVENTORY_SESSION_SECRET=
# First-run only: if there are zero inventory users, the first successful
# login attempt with these creates the Global Admin. Remove afterwards.
INVENTORY_BOOTSTRAP_ADMIN_USERNAME=
INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=
# Optional: extra allowed origins (comma-separated) if you serve the app
# through a proxy/domain that rewrites the Host header.
INVENTORY_ALLOWED_ORIGINS=
