// ATOZEE v2 — Prisma schema
// Self-hosted Postgres (Dokploy-managed service), connected via DATABASE_URL.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String?
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  city         String?
  state        String?
  address      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  passwordResetTokens PasswordResetToken[]
  quoteRequests       QuoteRequest[]
  orders              Order[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Delivery
// ---------------------------------------------------------------------------

model DeliveryRate {
  id        String   @id @default(uuid())
  state     String   @unique
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("delivery_rates")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  partNumber    String   @map("part_number")
  category      String
  description   String?
  price         Decimal  @db.Decimal(12, 2)
  inStock       Boolean  @default(true) @map("in_stock")
  images        String[]
  isActive      Boolean  @default(true) @map("is_active")
  engineNumbers String[] @map("engine_numbers") // renamed from engine_compatibility
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([engineNumbers])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Quotes & Orders
// ---------------------------------------------------------------------------

enum DeliveryMethod {
  delivery
  pickup
}

enum QuoteStatus {
  pending
  quoted
  accepted
  declined
  expired
}

model QuoteRequest {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id])
  items       Json
  notes       String?
  status      QuoteStatus @default(pending)

  deliveryMethod  DeliveryMethod @map("delivery_method")
  deliveryFee     Decimal?       @db.Decimal(12, 2) @map("delivery_fee")
  deliveryAddress String?        @map("delivery_address")

  fobPrice            Decimal? @db.Decimal(12, 2) @map("fob_price")
  shippingCost        Decimal? @db.Decimal(12, 2) @map("shipping_cost")
  shippingCbm         Decimal? @db.Decimal(12, 2) @map("shipping_cbm")
  freightClearingCost Decimal? @db.Decimal(12, 2) @map("freight_clearing_cost")
  localDeliveryCost   Decimal? @db.Decimal(12, 2) @map("local_delivery_cost")
  quotedTotal         Decimal? @db.Decimal(12, 2) @map("quoted_total")
  quoteSentAt         DateTime? @map("quote_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("quote_requests")
}

enum OrderStatus {
  pending
  paid
  failed
  cancelled
}

model Order {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  user              User        @relation(fields: [userId], references: [id])
  items             Json
  customerName      String      @map("customer_name")
  customerEmail     String      @map("customer_email")
  customerPhone     String      @map("customer_phone")
  amount            Decimal     @db.Decimal(12, 2)
  status            OrderStatus @default(pending)
  paystackReference String?     @unique @map("paystack_reference")

  deliveryMethod  DeliveryMethod @map("delivery_method")
  deliveryFee     Decimal        @default(0) @db.Decimal(12, 2) @map("delivery_fee")
  deliveryAddress String?        @map("delivery_address")

  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")

  @@index([userId])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// Inventory management (staff-only, separate login from the store admin)
// ---------------------------------------------------------------------------

enum InvRole {
  GLOBAL_ADMIN
  YUCHAI_STAFF
  ATOZEE_STAFF
}

enum InvMovementType {
  ADDED
  REMOVED
}

model InvUser {
  id             String   @id @default(uuid())
  username       String   @unique
  displayName    String   @map("display_name")
  passwordHash   String   @map("password_hash")
  role           InvRole
  language       String   @default("en")
  isActive       Boolean  @default(true) @map("is_active")
  // Bumped on password reset / role change so existing sessions stop working.
  sessionVersion Int      @default(0) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  movements InvMovement[]
  invoices  InvInvoice[]

  @@map("inv_users")
}

model InvItem {
  id          String   @id @default(uuid())
  partNumber  String   @unique @map("part_number")
  nameEn      String   @map("name_en")
  nameZh      String?  @map("name_zh")
  category    String
  description String?
  unit        String   @default("pcs")
  quantity    Int      @default(0)
  lowStockAt  Int      @default(5) @map("low_stock_at")
  priceNgn    Decimal  @default(0) @map("price_ngn") @db.Decimal(12, 2)
  invoiceable Boolean  @default(true)
  // Soft delete so the stock log keeps pointing at a real row.
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  movements InvMovement[]

  @@index([category])
  @@index([isDeleted])
  @@map("inv_items")
}

model InvMovement {
  id           String          @id @default(uuid())
  itemId       String          @map("item_id")
  item         InvItem         @relation(fields: [itemId], references: [id])
  // Snapshots, so the log stays readable even if the item is later renamed.
  partNumber   String          @map("part_number")
  itemName     String          @map("item_name")
  type         InvMovementType
  quantity     Int
  balanceAfter Int             @map("balance_after")
  reason       String
  userId       String?         @map("user_id")
  user         InvUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  username     String
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([type])
  @@index([itemId])
  @@map("inv_movements")
}

model InvInvoice {
  id              String   @id @default(uuid())
  number          String   @unique
  customerName    String   @map("customer_name")
  customerContact String?  @map("customer_contact")
  notes           String?
  lines           Json
  total           Decimal  @db.Decimal(14, 2)
  createdById     String?  @map("created_by_id")
  createdBy       InvUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByName   String   @map("created_by_name")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("inv_invoices")
}
